{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommitTypeAll(chore)"
  ],
  "configMigration": true,
  "enabledManagers": [
    "github-actions",
    "gomod",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Taskfile\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+[A-Z_]+_VERSION: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "groupName": "Go",
      "groupSlug": "go",
      "matchManagers": [
        "gomod"
      ],
      "addLabels": [
        "go"
      ],
      "description": [
        "Add go label to PRs which bump Go module dependencies.",
        "Group Go module updates in a single PR."
      ]
    },
    {
      "groupName": "Taskfile",
      "groupSlug": "taskfile",
      "matchFileNames": [
        "Taskfile.yaml"
      ],
      "addLabels": [
        "build"
      ],
      "description": [
        "Add build label to PRs which are related to build tools defined in the Taskfile.",
        "Group Taskfile dependency updates in a single PR."
      ]
    },
    {
      "groupName": "Github Actions",
      "groupSlug": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "ci"
      ],
      "description": [
        "Add ci label to PRs which are related to Github Actions.",
        "Group CI dependency updates in a single PR."
      ]
    },
    {
      "matchJsonata": [
        "$exists(vulnerabilityFixVersion) or isVulnerabilityAlert = true"
      ],
      "enabled": true,
      "description": [
        "Always allow vulnerability/security fixes, even when other rules disable specific dependencies."
      ]
    }
  ],
  "semanticCommits": "enabled",
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": [
    "before 8am on Monday",
    "before 8am on Wednesday",
    "before 8am on Friday"
  ],
  "prCreation": "not-pending",
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "rebaseWhen": "behind-base-branch",
  "reviewersFromCodeOwners": true,
  "timezone": "Etc/UTC",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  }
}
